# SCHEDULER SETTINGS 
DATE_FORMAT = "%Y%m%d"
REDIS_DB_SCHEDULER = 6  # Dedicated Redis DB for scheduler
REDIS_LOCK_TIMEOUT = 300  # 5 minutes - lock expires if task hangs
REDIS_SUCCESS_TTL = 86400  # 24 hours - task won't re-run same day

# Server settings
UVICORN_PORT=8050
STREAMLIT_PORT=8502
REDIS_DB=5
REDIS_POST=6379

# Ngrok Configuration (requires paid plan with reserved domain)
# Set to true to automatically start ngrok with run_streamlit.sh
USE_NGROK=false

NGROK_DOMAIN=xxx.ngrok-free.app

# =============================================================================
# Streamlit CORS Configuration
# =============================================================================
# Enable CORS for proxy/iframe access
STREAMLIT_SERVER_ENABLE_CORS=true

# Disable XSRF protection when behind trusted proxy (N8N, Vaettir)
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=false

# Comma-separated list of allowed origins
# Include your production domain, ngrok, and localhost for development
STREAMLIT_SERVER_ALLOWED_ORIGINS=http://localhost:8502,http://127.0.0.1:8502,https://ocapistaine.onrender.com,https://ocapistaine.ngrok-free.app,https://ocapistaine.vaettir.locki.io

# Optional: Set production domain for browser config
# STREAMLIT_BROWSER_SERVER_ADDRESS=ocapistaine.vaettir.locki.io
# STREAMLIT_BROWSER_SERVER_PORT=443
# Firecrawl API Configuration
# Get your API key from: https://firecrawl.dev

# Firecrawl API (for document crawling)
FIRECRAWL_API_KEY=your_key

# Opik/Comet (for LLM observability)
OPIK_API_KEY=your_key
OPIK_WORKSPACE=ocapistaine-dev

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Default provider for cloud deployment (openai, gemini, claude, mistral)
DEFAULT_PROVIDER=openai

# =============================================================================
# LLM Provider API Keys
# =============================================================================
# OpenAI (default for cloud deployment)
OPENAI_API_KEY=your_key
# Google Gemini (either key works)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_key
# GEMINI_API_KEY=your_key  # Alternative

# Anthropic Claude
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_key

# Mistral AI
# Get from: https://console.mistral.ai/
MISTRAL_STUDIO_API_KEY=your_key

# Mistral Document AI workspace (for RAG)
MISTRAL_WORKSPACE=ocapistaine-audierne-1

# Optional
VECTOR_STORE_TYPE=chroma  # or pinecone, qdrant
APP_ENV=development       # or production

# =============================================================================
# Docker / Cloud Deployment
# =============================================================================
# Authentication password (leave empty to disable auth)
# Can be plain text or hashed: sha256:hexdigest
# Generate hash: python -c "from app.auth import hash_password; print(hash_password('your-password'))"
STREAMLIT_AUTH_PASSWORD=

# For docker-compose, Redis is automatically configured via service name
# REDIS_HOST=redis  # Set by docker-compose
# REDIS_PORT=6379   # Set by docker-compose

